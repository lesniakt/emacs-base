(require 'ert)
(require 'cl-lib)

(ert-deftest emacs-base-startup-contract ()
  (should-not emacs-base-test-warnings)
  (should (featurep 'emacs-base))
  (should emacs-base-extension-loaded)
  (should global-auto-revert-mode)
  (should evil-mode)
  (should ivy-mode)
  (should-not use-package-always-ensure)
  (should-not (file-exists-p (expand-file-name "elpa" user-emacs-directory)))
  (should (eq (key-binding (kbd "C-c c")) #'org-capture))
  (should (eq (key-binding (kbd "C-c l")) #'org-store-link))
  (should (featurep 'forge))
  (should (featurep 'emacs-base-lsp))
  (should-not lsp-enable-suggest-server-download)
  (dolist (id '(emacs-base-remote-c emacs-base-remote-kotlin emacs-base-remote-typescript))
    (should (lsp--client-remote? (gethash id lsp-clients)))))

(ert-deftest emacs-base-remote-paths-do-not-connect ()
  (let ((org-directory "/ssh:example.invalid:~/org"))
    (cl-letf (((symbol-function 'process-file) (lambda (&rest _) (error "Remote startup I/O")))
              ((symbol-function 'start-file-process) (lambda (&rest _) (error "Remote startup I/O"))))
      (should (equal (emacs-base-org-file "TaskInbox.org")
                     "/ssh:example.invalid:~/org/TaskInbox.org")))))

(ert-deftest emacs-base-org-workflow ()
  (let* ((org-directory (make-temp-file "org-workflow-" t))
         (org-agenda-files (list (emacs-base-org-file "TaskInbox.org")))
         (org-id-locations-file (expand-file-name "ids" org-directory))
         (org-clock-persist nil))
    (org-capture-string "Synthetic task" "tt")
    (org-capture-finalize)
    (with-current-buffer (find-file-noselect (emacs-base-org-file "TaskInbox.org"))
      (goto-char (point-min))
      (should (search-forward "Synthetic task" nil t))
      (org-back-to-heading)
      (org-schedule nil "2030-01-15 09:00-09:30")
      (should (org-id-get-create))
      (org-clock-in)
      (should (org-clocking-p))
      (org-clock-out)
      (should-not (org-clocking-p))
      (should (org-entry-get nil "SCHEDULED"))
      (org-todo "DONE")
      (save-buffer)
      (goto-char (point-min))
      (should (search-forward "CLOCK:" nil t))
      (kill-buffer))
    (org-agenda-list nil "2030-01-15" 1)
    (with-current-buffer org-agenda-buffer-name
      (should (string-match-p "Synthetic task" (buffer-string))))
    (org-capture-string "Synthetic note" "n")
    (org-capture-finalize)
    (should (file-exists-p (emacs-base-org-file "Notes.org")))
    (org-capture-string "Synthetic journal" "jj")
    (org-capture-finalize)
    (should (file-exists-p (emacs-base-org-file "Journal.org")))) )

(ert-deftest emacs-base-refresh-preserves-unsaved-text ()
  (let ((file (make-temp-file "org-refresh-" nil ".org" "* Initial\n"))
        (auto-revert-use-notify nil))
    (unwind-protect
        (with-current-buffer (find-file-noselect file)
          (auto-revert-mode 1)
          (let ((coding-system-for-write 'utf-8))
            (write-region "* Disk update\n" nil file nil 'silent))
          (set-file-times file (time-add (current-time) 2))
          (auto-revert-buffers)
          (should (string-match-p "Disk update" (buffer-string)))
          (goto-char (point-max)) (insert "unsaved text\n")
          (write-region "* Another disk update\n" nil file nil 'silent)
          (set-file-times file (time-add (current-time) 4))
          (auto-revert-buffers)
          (should (string-match-p "unsaved text" (buffer-string)))
          (set-buffer-modified-p nil)
          (kill-buffer))
      (delete-file file))))
