;;; tramp-tests.el --- Isolated SSH workflow -*- lexical-binding: t; -*-
;; SPDX-License-Identifier: MIT
(load (getenv "FIXTURE_INIT") nil nil t)
(require 'ert)
(require 'tramp)
(let ((arguments (assoc 'tramp-login-args (cdr (assoc "ssh" tramp-methods)))))
  (setf (cadr arguments)
        (cons (list "-F" (concat (getenv "FIXTURE_ROOT") "/ssh_config"))
              (cadr arguments))))

(ert-deftest emacs-base-tramp-capture-and-clock ()
  (let* ((org-directory (concat "/ssh:fixture:" (getenv "FIXTURE_ROOT") "/org"))
         (org-agenda-files (list (emacs-base-org-file "TaskInbox.org"))))
    (org-capture-string "Remote synthetic task" "tt")
    (org-capture-finalize)
    (with-current-buffer (find-file-noselect (emacs-base-org-file "TaskInbox.org"))
      (should (file-remote-p buffer-file-name))
      (goto-char (point-min))
      (re-search-forward "^\\* " nil t)
      (org-schedule nil "2030-01-15 10:00-10:30")
      (org-clock-in)
      (org-clock-out)
      (save-buffer)
      (revert-buffer t t)
      (should (search-forward "Remote synthetic task" nil t))
      (should (search-forward "CLOCK:" nil t)))
    (org-agenda-list nil "2030-01-15" 1)
    (with-current-buffer org-agenda-buffer-name
      (should (string-match-p "Remote synthetic task" (buffer-string))))))

(ert-deftest emacs-base-tramp-client-placement ()
  ;; Exercise LSP's real stdio transport. Only the SSH server sets this marker.
  (let* ((default-directory (concat "/ssh:fixture:" (getenv "FIXTURE_ROOT") "/"))
         (lsp-use-workspace-root-for-server-default-directory nil)
         (output "")
         (connection (lsp-tramp-connection '("sh" "-c" "printf %s \"$EMACS_BASE_FIXTURE\"")))
         (process (car (funcall (plist-get connection :connect)
                               (lambda (_process text) (setq output (concat output text)))
                               #'ignore "fixture-lsp" nil nil)))
         (deadline (+ (float-time) 20)))
    (unwind-protect
        (progn
          (while (and (process-live-p process) (< (float-time) deadline))
            (accept-process-output process 0.1))
          (should-not (process-live-p process))
          (should (string-match-p "remote" output)))
      (when (process-live-p process) (delete-process process))))
  (dolist (id '(emacs-base-remote-c emacs-base-remote-kotlin emacs-base-remote-typescript))
    (should (lsp--client-remote? (gethash id lsp-clients)))))
