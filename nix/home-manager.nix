{ config, lib, pkgs, ... }:
let
  cfg = config.programs.emacs-base;
  settings = {
    inherit (cfg) orgDirectory agendaFiles;
  };
  init = ''
    ;;; init.el --- Generated by Home Manager -*- lexical-binding: t; -*-
    (setq package-enable-at-startup nil)
    ;; GUI applications need these tools even without a login-shell PATH.
    (dolist (directory '("${lib.getBin pkgs.git}/bin" "${lib.getBin pkgs.openssh}/bin"
                         "${lib.getBin pkgs.ripgrep}/bin"))
      (add-to-list 'exec-path directory)
      (setenv "PATH" (concat directory path-separator (getenv "PATH"))))
    (setq emacs-base-settings
          (json-parse-string ${builtins.toJSON (builtins.toJSON settings)}
                             :object-type 'alist :array-type 'list :false-object nil))
    (add-to-list 'load-path "${../lisp}")
    (require 'emacs-base)
    ${cfg.extraConfig}
  '';
in {
  options.programs.emacs-base = {
    enable = lib.mkEnableOption "the portable Emacs base";
    orgDirectory = lib.mkOption {
      type = lib.types.str;
      default = "~/org";
      description = "Org directory, either local or a TRAMP name. Accessed on demand.";
    };
    agendaFiles = lib.mkOption {
      type = lib.types.listOf lib.types.str;
      default = [ "TaskInbox.org" ];
      description = "Agenda filenames relative to orgDirectory.";
    };
    extraConfig = lib.mkOption {
      type = lib.types.lines;
      default = "";
      description = "Elisp evaluated after the base. Never include credentials here.";
    };
  };
  config = lib.mkIf cfg.enable {
    programs.emacs = {
      enable = true;
      package = lib.mkDefault (if pkgs.stdenv.hostPlatform.isDarwin then pkgs.emacs else pkgs.emacs-nox);
      extraPackages = ep: with ep; [
        use-package general evil evil-collection ivy ivy-rich counsel helpful
        doom-themes doom-modeline all-the-icons magit projectile counsel-projectile
        company company-box kotlin-mode typescript-mode evil-nerd-commenter
        rainbow-delimiters org-bullets visual-fill-column hydra
        lsp-mode lsp-ui lsp-treemacs lsp-ivy forge
      ];
    };
    home.packages = with pkgs; [ fira-code cantarell-fonts emacs-all-the-icons-fonts ];
    fonts.fontconfig.enable = lib.mkIf pkgs.stdenv.hostPlatform.isLinux true;
    home.file.".emacs.d/early-init.el".text = "(setq package-enable-at-startup nil)\n";
    home.file.".emacs.d/init.el".text = init;
  };
}
